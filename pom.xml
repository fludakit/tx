<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fludakit</groupId>
        <artifactId>fludakit-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>fluda-tx-parent</artifactId>
    <packaging>pom</packaging>

    <name>FluDa :: Transaction Support</name>
    <description>Container-agnostic declarative and programmatic transaction boundaries.</description>
    <url>https://github.com/fludakit/tx</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Hantsy Bai</name>
            <email>hantsy@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/fludakit/tx.git</connection>
        <developerConnection>scm:git:ssh://github.com/fludakit/tx.git</developerConnection>
        <url>https://github.com/fludakit/tx</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>core</module>
        <module>cdi</module>
        <module>jdbc</module>
        <module>jpa</module>
    </modules>

    <properties>
        <!-- Module-specific properties can be added here -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Transaction modules -->
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-tx-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-tx-cdi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-tx-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-tx-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Module-specific plugin configurations can be added here -->
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Module-specific profiles can be added here -->
    </profiles>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/fludakit/tx</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <name>GitHub Packages - Fludakit Org</name>
            <id>github-fludakit</id>
            <url>https://maven.pkg.github.com/fludakit/*</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
